# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.
#
#   cp .env.example .env
#   # then replace every CHANGE_ME value below, e.g.:
#   openssl rand -base64 48 | tr -d '\n'   # for *_KEY values
#   openssl rand -hex 24                   # for passwords

# --- Compose project name ---
# Pinned explicitly so `docker compose` commands behave the same regardless
# of which directory this file lives in (default project name is derived
# from the containing directory name otherwise).
COMPOSE_PROJECT_NAME=defectdojo

# --- Image pinning ---
# Pin to a specific DefectDojo release instead of "latest" for reproducibility.
# See: https://github.com/DefectDojo/django-DefectDojo/releases
DJANGO_VERSION=3.4.304
NGINX_VERSION=3.4.304
# Set to docker.io to pull directly from Docker Hub instead of DefectDojo's
# own pull-through registry (registry.defectdojo.com).
# DD_IMAGE_REGISTRY=docker.io

# --- Network ---
DD_PORT=8080
DD_ALLOWED_HOSTS=*

# --- Database (Postgres) ---
DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=CHANGE_ME
DD_DATABASE_HOST=postgres
DD_DATABASE_PORT=5432
# Must stay consistent with the three values above.
DD_DATABASE_URL=postgresql://defectdojo:CHANGE_ME@postgres:5432/defectdojo

# --- Django secrets ---
# 32+ random characters each.
DD_SECRET_KEY=CHANGE_ME
DD_CREDENTIAL_AES_256_KEY=CHANGE_ME

# --- Admin bootstrap (initializer) ---
# Password is NOT settable here by design in upstream DefectDojo: if left
# unset, a random one is generated and printed in the initializer logs on
# first boot. See README for how to retrieve it.
DD_ADMIN_USER=admin
DD_ADMIN_MAIL=admin@defectdojo.local
DD_ADMIN_FIRST_NAME=Admin
DD_ADMIN_LAST_NAME=User
DD_INITIALIZE=true
